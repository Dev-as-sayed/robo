# Copy to apps/mobile/.env and restart Expo.
# A physical phone must use the LAN address of the machine running the API.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# Prefer a monitored support mailbox for production. The app falls back to the
# public issue tracker when this is empty.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_URL=https://github.com/Dev-as-sayed/robo/issues/new
