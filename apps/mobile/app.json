{
  "expo": {
    "name": "Robo",
    "slug": "robo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "robo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Robo uses a photo you choose to explain formulas and study problems.",
          "cameraPermission": "Robo uses the camera to photograph formulas and study problems you want explained.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Robo reads only the contact you choose in the contact picker when you ask it to help you call or message someone."
        }
      ],
      "@sentry/react-native",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.robo.app"
    },
    "android": {
      "package": "com.robo.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c632857-8789-4ed8-9486-078bdd7a45ca"
      }
    },
    "owner": "amsayed231"
  }
}
