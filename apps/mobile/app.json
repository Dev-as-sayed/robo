{
  "expo": {
    "name": "Robo",
    "slug": "robo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "robo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.robo.app"
    },
    "android": {
      "package": "com.robo.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
