# Copy to apps/server/.env (or export these) for local development.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8081

DATABASE_URL=postgresql://robo:robo_password@localhost:5432/robo
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
PAIRING_RATE_LIMIT_MAX=20
PAIRING_CODE_TTL_MINUTES=10
TRUST_PROXY=0

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=robo-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=900
DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_USER_QUOTA_BYTES=262144000
DOCUMENT_USER_QUOTA_COUNT=100
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=900

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434

LLM_VOICE_CHAT_CHAIN=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash,openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:llama3.2
LLM_AGENT_TOOLS_CHAIN=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:llama3.2
LLM_STRUCTURED_CHAIN=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:llama3.2
LLM_VISION_CHAIN=gemini:gemini-2.5-flash
LLM_PRIVATE_DOCS_CHAIN=ollama:llama3.2

EMBEDDING_MODEL=bge-m3
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_SCORE_THRESHOLD=0.35

REMINDER_SCHEDULER_ENABLED=true
REMINDER_TICK_INTERVAL_MS=15000
NUDGE_SCHEDULER_ENABLED=true
NUDGE_TICK_INTERVAL_MS=300000
CLASS_NOTE_PROMPT_ENABLED=true
CLASS_NOTE_TICK_INTERVAL_MS=60000
CLEANUP_JOB_ENABLED=true
CLEANUP_INTERVAL_MS=86400000
DATA_RETENTION_DAYS=90

STT_SERVICE_URL=http://localhost:8001
STT_SERVICE_TIMEOUT_MS=30000
STT_LANGUAGE=en
GROQ_STT_MODEL=whisper-large-v3-turbo

TTS_SERVICE_URL=http://localhost:8002
TTS_SERVICE_TIMEOUT_MS=15000
TTS_VOICE=en_US-lessac-medium
TTS_VOICE_MAP=
TTS_SAMPLE_RATE=16000
