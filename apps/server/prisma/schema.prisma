generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  REGIONAL_BRAND_OWNER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DeviceStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
}

enum ConversationChannel {
  APP
  DEVICE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ActionLogStatus {
  SUCCESS
  ERROR
  CONFIRMATION_REQUIRED
}

enum PendingActionKind {
  CALL
  MESSAGE
  EMAIL
  WHATSAPP
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum NudgeType {
  TASK
  EXAM
  STUDY
  REMINDER
}

enum ConsentKind {
  MICROPHONE
  CONTACTS
  DOCUMENTS
  CLOUD_AI
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String?
  passwordHash       String?
  googleId           String?             @unique
  role               UserRole            @default(USER)
  status             UserStatus          @default(ACTIVE)
  region             String?
  brand              String?
  suspendedAt        DateTime?
  suspensionReason   String?
  timezone           String              @default("UTC")
  locale             String              @default("en")
  quietHours         Json?
  wakePhrase         String              @default("hey robo")
  nudgeSettings      Json?
  cloudAiForDocs     Boolean             @default(false)
  guardianConsent    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  devices            Device[]
  pairingCodes       DevicePairingCode[]
  conversations      Conversation[]
  todos              Todo[]
  reminders          Reminder[]
  scheduleEntries    ScheduleEntry[]
  scheduleExceptions ScheduleException[]
  exams              Exam[]
  studyPlans         StudyPlan[]
  documents          Document[]
  quizzes            Quiz[]
  quizAttempts       QuizAttempt[]
  contacts           Contact[]
  subjects           Subject[]
  topics             Topic[]
  studySessions      StudySession[]
  dailyStats         DailyStats[]
  actionLogs         ActionLog[]
  pushTokens         PushToken[]
  pendingActions     PendingAction[]
  nudges             Nudge[]
  memories           Memory[]
  classNotes         ClassNote[]
  aiUsage            AiUsage[]
  consents           UserConsent[]
  aiFeedback         AiFeedback[]
  deletionRequests   AccountDeletionRequest[]

  @@index([role])
  @@index([status])
  @@index([region, brand])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id              String       @id @default(uuid())
  deviceId        String       @unique
  name            String?
  tokenHash       String?      @unique
  firmwareVersion String?
  locale          String?
  status          DeviceStatus @default(PENDING)
  lastSeenAt      DateTime?
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

model DevicePairingCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model Conversation {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   ConversationChannel @default(APP)
  title     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  voiceText      String?
  displayContent Json?
  createdAt      DateTime     @default(now())
  aiFeedback     AiFeedback[]

  @@index([conversationId, createdAt])
}

enum AiFeedbackSurface {
  CHAT
  VISION
}

enum AiFeedbackReason {
  OFFENSIVE
  UNSAFE
  INCORRECT
  OTHER
}

enum AiFeedbackStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model AiFeedback {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface      AiFeedbackSurface
  messageId    String?
  message      Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  responseText String?
  reason       AiFeedbackReason
  details      String?
  status       AiFeedbackStatus  @default(OPEN)
  createdAt    DateTime          @default(now())

  @@index([messageId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  DISMISSED
}

model AccountDeletionRequest {
  id          String                @id @default(uuid())
  email       String                @unique
  userId      String?
  user        User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String?
  status      DeletionRequestStatus @default(PENDING)
  note        String?
  requestedAt DateTime              @default(now())
  processedAt DateTime?
  updatedAt   DateTime              @updatedAt

  @@index([status, requestedAt])
}

enum ReminderChannel {
  device
  phone
  push
}

enum ReminderDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model ReminderDelivery {
  id         String                @id @default(uuid())
  reminderId String
  userId     String
  dueAt      DateTime
  channel    ReminderChannel
  status        ReminderDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  error         String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([reminderId, dueAt, channel])
  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
}

model DevicePendingEvent {
  id          String    @id @default(uuid())
  userId      String
  message     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([userId, deliveredAt, createdAt])
}

model Todo {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  warned24hAt DateTime?
  warned2hAt  DateTime?
  subject     String?
  priority    String    @default("medium")
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  studyTask   DailyTask?

  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, dueAt])
}

model Reminder {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String
  at           DateTime?
  rrule        String?
  nextAt       DateTime?
  lastFiredAt  DateTime?
  channels     String[]  @default(["device", "phone", "push"])
  linkedEntity String?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([id, userId])
  @@index([userId, status])
  @@index([status, nextAt])
}

/// Registered device tokens. Storage only: the push send itself needs Expo/FCM
/// credentials, so rows are written and listed but never dispatched yet.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

model ScheduleEntry {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime?
  allDay           Boolean             @default(false)
  subject          String?
  room             String?
  teacher          String?
  alertLeadMinutes Int?
  alertAt          DateTime?
  alertedAt        DateTime?
  notePromptedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  exceptions       ScheduleException[]
  notes            ClassNote[]

  @@unique([id, userId])
  @@index([userId, startAt])
  @@index([alertedAt, alertAt])
  @@index([notePromptedAt, endAt])
}

model ScheduleException {
  id         String        @id @default(uuid())
  scheduleId String
  schedule   ScheduleEntry @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  reason     String?
  createdAt  DateTime      @default(now())

  @@unique([id, userId])
  @@index([scheduleId])
}

model Exam {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  date      DateTime
  topics    String[]   @default([])
  weight    Float?
  status    String     @default("draft")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  studyPlan StudyPlan?

  @@unique([id, userId])
  @@index([userId, date])
}

model StudyPlan {
  id         String      @id @default(uuid())
  examId     String      @unique
  exam       Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalDays  Int
  approvedAt DateTime?
  reminderId String?
  dailyTasks DailyTask[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([id, userId])
  @@index([userId])
}

model DailyTask {
  id        String    @id @default(uuid())
  planId    String
  plan      StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  todoId    String?   @unique
  todo      Todo?     @relation(fields: [todoId], references: [id], onDelete: SetNull)
  day       Int
  title     String
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([planId])
}

model Document {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  size         Int
  mimeType     String
  s3Key        String?
  s3Url        String?
  status       String    @default("pending")
  subject      String?
  checksum     String?
  pageCount    Int?
  chunkCount   Int       @default(0)
  attempts     Int       @default(0)
  error        String?
  embeddingModel String?
  lockedAt     DateTime?
  nextAttemptAt DateTime?
  indexedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([id, userId])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
}

model Quiz {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  subject       String?
  topic         String?
  questionCount Int
  questions     QuizQuestion[]
  attempts      QuizAttempt[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([id, userId])
  @@index([userId])
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  options       String[]
  correctAnswer String
  explanation   String?

  @@index([quizId])
}

model QuizAttempt {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId     String
  quiz       Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score      Int?
  answeredAt DateTime?
  results    Json
  createdAt  DateTime  @default(now())

  @@unique([id, userId])
  @@index([userId, answeredAt])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pendingActions PendingAction[]

  @@unique([id, userId])
  @@index([userId])
}

model ClassNote {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleEntryId String?
  scheduleEntry   ScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)
  subject         String?
  title           String
  content         String
  classAt         DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([id, userId])
  @@index([userId, classAt])
  @@index([scheduleEntryId])
}

model Memory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([userId, category])
}

model Nudge {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NudgeType
  localDay  String
  title     String
  body      String
  createdAt DateTime  @default(now())

  @@unique([userId, type, localDay])
  @@index([userId, localDay])
}

model PendingAction {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  kind           PendingActionKind
  recipientName  String
  recipientPhone String?
  recipientEmail String?
  body           String?
  status         PendingActionStatus @default(PENDING)
  expiresAt      DateTime
  confirmedAt    DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([id, userId])
  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
}

model Subject {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  topics    Topic[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId])
}

model Topic {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  masteryScore Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([id, userId])
  @@unique([subjectId, name])
  @@index([userId])
  @@index([subjectId])
}

enum StudySessionStatus {
  active
  paused
  ended
}

model StudySession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String?
  status          StudySessionStatus @default(active)
  plannedMinutes  Int?
  extendedMinutes Int       @default(0)
  pausedAt        DateTime?
  totalPausedMs   Int       @default(0)
  startedAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())

  @@unique([id, userId])
  @@index([userId, startedAt])
}

model DailyStats {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  studyMinutes      Int      @default(0)
  completedTasks    Int      @default(0)
  completedQuizzes  Int      @default(0)
  quizScoreSum      Int      @default(0)
  quizScoreCount    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model ActionLog {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  toolName       String
  input          Json
  output         Json?
  status         ActionLogStatus @default(SUCCESS)
  error          String?
  durationMs     Int
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model AiUsage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          DateTime @db.Date
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

model UserConsent {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          ConsentKind
  granted       Boolean
  policyVersion String      @default("2026-10")
  source        String?
  grantedAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, kind])
  @@index([userId, granted])
}
