{
  "name": "robo",
  "version": "1.0.0",
  "description": "Student AI Assistant monorepo",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter robo-server dev",
    "lint": "pnpm --filter robo-server lint",
    "typecheck": "pnpm --filter robo-server typecheck",
    "test": "pnpm --filter robo-server test",
    "build": "pnpm --filter robo-server build",
    "db:generate": "pnpm --filter robo-server db:generate",
    "db:migrate": "pnpm --filter robo-server db:migrate",
    "mobile:dev": "pnpm --filter robo-mobile dev",
    "mobile:typecheck": "pnpm --filter robo-mobile typecheck",
    "mobile:lint": "pnpm --filter robo-mobile lint",
    "shared:typecheck": "pnpm --filter @robo/shared typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "8.57.1",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  }
}