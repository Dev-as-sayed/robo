# Server Configuration
PORT=3000
NODE_ENV=development

# Database
POSTGRES_PASSWORD=robo_password
DATABASE_URL=postgresql://robo:robo_password@localhost:5432/robo

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
PAIRING_RATE_LIMIT_MAX=20
PAIRING_CODE_TTL_MINUTES=10
TRUST_PROXY=0

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_minimally_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google sign-in
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Redis
REDIS_URL=redis://localhost:6379

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=robo-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI / LLM
AI_RATE_LIMIT_MAX=30
AI_HISTORY_MESSAGES=20
AI_MAX_OUTPUT_TOKENS=512
AI_TEMPERATURE=0.4
AI_AGENT_STEP_LIMIT=8

# Add at least one provider key, or run Ollama and set OLLAMA_BASE_URL.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_BASE_URL=http://localhost:11434

# Model routing is configuration-driven. Format: provider:model, comma-separated fallback chain.
# Supported providers: gemini, groq, openrouter, ollama
LLM_VOICE_CHAT_CHAIN=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash,openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:llama3.2
LLM_AGENT_TOOLS_CHAIN=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:llama3.2
LLM_STRUCTURED_CHAIN=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:llama3.2
LLM_VISION_CHAIN=gemini:gemini-2.5-flash
LLM_PRIVATE_DOCS_CHAIN=ollama:llama3.2

# Embeddings / RAG (Qdrant)
EMBEDDING_MODEL=bge-m3
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_SCORE_THRESHOLD=0.35

# CORS
CORS_ORIGIN=http://localhost:3000

# Langfuse (optional; tracing is disabled when keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Environment
NEXT_PUBLIC_BASE_URL=http://localhost:3000